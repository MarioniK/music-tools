# `genre-classifier` env example.
# Все значения ниже являются placeholder-ами. Реальные секреты сюда не добавлять.

# Optional: Current production default is onnx_musicnn.
# legacy_musicnn remains a rollback/fallback value, not the default.
GENRE_PROVIDER=onnx_musicnn

# Optional: LLM client for the `llm` provider and shadow path.
LLM_CLIENT=stub

# Optional: Required only when LLM_CLIENT=local_http.
LLM_LOCAL_HTTP_ENDPOINT=http://your-local-llm-endpoint:8000/infer

# Optional: Timeout for the local_http client, seconds.
LLM_LOCAL_HTTP_TIMEOUT_SECONDS=5.0

# Optional: ONNX artifacts path; used only when GENRE_PROVIDER=onnx_musicnn.
ONNX_MUSICNN_MODEL_PATH=/opt/genre-classifier/onnx/msd-musicnn-1.onnx

# Optional: ONNX metadata path; used only when GENRE_PROVIDER=onnx_musicnn.
ONNX_MUSICNN_METADATA_PATH=/opt/genre-classifier/onnx/msd-musicnn-1.json

# Optional: Runtime shadow path. Disabled by default in code.
GENRE_CLASSIFIER_SHADOW_ENABLED=false

# Optional: Shadow provider. Default in code is llm.
GENRE_CLASSIFIER_SHADOW_PROVIDER=llm

# Optional: Shadow sampling rate between 0.0 and 1.0.
GENRE_CLASSIFIER_SHADOW_SAMPLE_RATE=0.0

# Optional: Shadow timeout in seconds.
GENRE_CLASSIFIER_SHADOW_TIMEOUT_SECONDS=2.0

# Optional: Whether to store shadow artifacts on disk.
GENRE_CLASSIFIER_SHADOW_ARTIFACTS_ENABLED=false

# Optional: Directory for shadow artifacts.
GENRE_CLASSIFIER_SHADOW_ARTIFACTS_DIR=evaluation/artifacts/runtime_shadow

# Optional: Max concurrent shadow requests.
GENRE_CLASSIFIER_SHADOW_MAX_CONCURRENT=1
