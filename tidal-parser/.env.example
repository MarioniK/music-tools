# `tidal-parser` env example.
# Все значения ниже являются placeholder-ами. Реальные секреты сюда не добавлять.

# Required: TIDAL Open API credentials for candidate lookup and safe handoff.
TIDAL_CLIENT_ID=your_tidal_client_id_here
TIDAL_CLIENT_SECRET=your_tidal_client_secret_here

# Optional: Discogs enrichment token. Leave empty to disable Discogs calls.
DISCOGS_TOKEN=

# Optional: Contact email for MusicBrainz User-Agent. Recommended for polite API usage.
MUSICBRAINZ_CONTACT_EMAIL=you@example.com

# Optional: Minimum interval between MusicBrainz requests, seconds.
MUSICBRAINZ_MIN_INTERVAL_S=1.1

# Optional: Clear-cache gate. Default in code is true; set false only for manual debugging.
CLEAR_CACHE_ENABLED=true

# Optional: Internal audio-classifier endpoint. Defaults to the in-network service URL.
AUDIO_CLASSIFIER_URL=http://genre-classifier:8021/classify
